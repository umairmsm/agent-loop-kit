def load_user_config():
    if os.path.exists(USER_CONFIG_FILE):
        try:
            with open(USER_CONFIG_FILE, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}
    return {}


def save_user_config(cfg):
    os.makedirs(os.path.dirname(USER_CONFIG_FILE), exist_ok=True)
    with open(USER_CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2)


def estimate_tokens(text):
    return max(1, len(text) // 4)


def print_telemetry_hud(model_id, prompt_text=""):
    spec = MODEL_SPECS.get(model_id, {
        "display": model_id,
        "family": "Custom",
        "context_window": 128_000,
        "type": "API / CLI"
    })
    ctx_max = spec["context_window"]
    est_prompt = estimate_tokens(prompt_text) if prompt_text else 0
    tokens_left = max(0, ctx_max - est_prompt) if prompt_text else ctx_max
    pct_left = (tokens_left / ctx_max) * 100 if ctx_max > 0 else 0

    print("┌" + "─" * 68 + "┐", file=sys.stderr)
    print(f"│ 🧠 SUPERVISOR HUD: Live Model & Token Telemetry                    │", file=sys.stderr)
    print("├" + "─" * 68 + "┤", file=sys.stderr)
    print(f"│ Model Active:   {spec['display'][:48]:<48} │", file=sys.stderr)
    print(f"│ Provider ID:    {model_id[:48]:<48} │", file=sys.stderr)
    ctx_str = f"{ctx_max:,} tokens ({spec['type']})"
    print(f"│ Context Window: {ctx_str[:48]:<48} │", file=sys.stderr)
    if prompt_text:
        load_str = f"~{est_prompt:,} tokens (diff, spec, gate evidence)"
        print(f"│ Payload Size:   {load_str[:48]:<48} │", file=sys.stderr)
        left_str = f"~{tokens_left:,} tokens ({pct_left:.1f}% headroom left)"
        print(f"│ Available Left: {left_str[:48]:<48} │", file=sys.stderr)
    print("├" + "─" * 68 + "┤", file=sys.stderr)
    print(f"│ ⚡ 1-KEY SHORTCUTS (use 's <num>' or 'model <num>'):               │", file=sys.stderr)
    print(f"│   s 1 (Claude)         s 2 (Qwen 480B)       s 3 (DeepSeek)        │", file=sys.stderr)
    print(f"│   s 4 (Gemini)         s 5 (Local R1)        s 6 (GPT-OSS 120B)    │", file=sys.stderr)
    print("└" + "─" * 68 + "┘", file=sys.stderr)


def switch_model_interactive(target_model=None):
    cfg = load_user_config()
    if target_model:
        target_model = target_model.strip()
        resolved = SHORTCUT_MAP.get(target_model.lower(), target_model)
        cfg["preferred_model"] = resolved
        save_user_config(cfg)
        disp = MODEL_SPECS.get(resolved, {}).get("display", resolved)
        print(f"\n✅ Active Supervisor switched to: {disp} ({resolved})")
        print_telemetry_hud(resolved)
        return

    current = cfg.get("preferred_model", DEFAULT_CASCADE[0])
    print("==================================================")
    print("       Supervisor Model Switcher & Selector       ")
    print("==================================================")
    print(f"Current Preferred Model: {current}\n")
    print("Choose a model number to set as your primary supervisor:")
    shortcuts_order = ["1", "2", "3", "4", "5", "6", "7", "8"]
    for s_key in shortcuts_order:
        m_id = SHORTCUT_MAP[s_key]
        spec = MODEL_SPECS.get(m_id, {})
        mark = "👉 (CURRENT)" if m_id == current else "  "
        print(f"  [{s_key}] {mark} {spec.get('display', m_id):<26} | {spec.get('context_window', 0):,} ctx | {spec.get('type', '')}")
    print("==================================================")
    try:
        choice = input("Enter number to select (e.g. 1, 2, 5) or press Enter to keep: ").strip()
    except (KeyboardInterrupt, EOFError):
        print("\nCancelled.")
        return

    if not choice:
        print("Kept current model.")
        return

    choice_resolved = SHORTCUT_MAP.get(choice.lower())
    if choice_resolved:
        cfg["preferred_model"] = choice_resolved
        save_user_config(cfg)
        disp = MODEL_SPECS.get(choice_resolved, {}).get("display", choice_resolved)
        print(f"\n✅ Active Supervisor switched to: {disp} ({choice_resolved})")
        print_telemetry_hud(choice_resolved)
    else:
        print(f"Unknown shortcut '{choice}'. Type 'brain' to see options.")


def ensure_cache():
    os.makedirs(CACHE_DIR, exist_ok=True)
    if not os.path.exists(COOLDOWN_FILE):
        with open(COOLDOWN_FILE, "w", encoding="utf-8") as f:
            json.dump({}, f)


def load_cooldowns():
    ensure_cache()
    try:
        with open(COOLDOWN_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def set_cooldown(provider_id, seconds_from_now=3600, reason="quota_exhausted"):
    cooldowns = load_cooldowns()
    until = int(time.time()) + max(60, int(seconds_from_now))
    cooldowns[provider_id] = {
        "cooldown_until": until,
        "cooldown_until_iso": datetime.fromtimestamp(until, timezone.utc).isoformat(),
        "reason": reason,
        "recorded_at": datetime.now(timezone.utc).isoformat()
    }
    with open(COOLDOWN_FILE, "w", encoding="utf-8") as f:
        json.dump(cooldowns, f, indent=2)
    print(f"supervisor-router: marked {provider_id} on cooldown for {seconds_from_now}s ({reason})", file=sys.stderr)


def is_on_cooldown(provider_id):
    cooldowns = load_cooldowns()
    entry = cooldowns.get(provider_id)
    if not entry:
        return False, ""
    until = entry.get("cooldown_until", 0)
    now = int(time.time())
    if now < until:
        remaining_min = int((until - now) / 60)
        return True, f"cooldown active ({remaining_min}m remaining; {entry.get('reason', '')})"
    return False, ""


def load_repo_config():
    """Load settings from ~/.config/agent-loop/credentials.env and .supervision/loop.conf."""
    # 1. Load user-global secure credentials (~/.config/agent-loop/credentials.env)
    user_cred = os.path.expanduser("~/.config/agent-loop/credentials.env")
    if os.path.exists(user_cred):
        try:
            with open(user_cred, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, v = line.split("=", 1)
                        k = k.strip()
                        v = v.strip().strip('"').strip("'")
                        if k and not os.environ.get(k):
                            os.environ[k] = v
        except Exception:
            pass

    # 2. Load repo-local settings (.supervision/loop.conf)
    try:
        root = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()
        conf_path = os.path.join(root, ".supervision", "loop.conf")
        if os.path.exists(conf_path):
            with open(conf_path, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, v = line.split("=", 1)
                        k = k.strip()
                        v = v.strip().strip('"').strip("'")
                        if k and not os.environ.get(k):
                            os.environ[k] = v
    except Exception:
        pass


def ensure_key(provider_name):
    """Retrieve an API key from environment, ~/.config/agent-loop/credentials.env,
    or prompt interactively on the fly if running in a terminal."""
    env_var = f"{provider_name.upper()}_API_KEY"
    val = os.environ.get(env_var, "").strip()
    if val:
        return val

    cred_file = os.path.expanduser("~/.config/agent-loop/credentials.env")
    if os.path.exists(cred_file):
        try:
            with open(cred_file, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, v = line.split("=", 1)
                        if k.strip() == env_var and v.strip():
                            val = v.strip().strip('"').strip("'")
                            os.environ[env_var] = val
                            return val
        except Exception:
            pass

    # Prompt interactively on the fly if running in a terminal
    if sys.stdin.isatty():
        print(f"\n[supervisor-router] 🔑 {provider_name.upper()} API key is required ({env_var}).", file=sys.stderr)
        try:
            import getpass
            try:
                user_input = getpass.getpass(f"Paste your {provider_name} API key (or Enter to skip): ").strip()
            except Exception:
                user_input = input(f"Paste your {provider_name} API key (or Enter to skip): ").strip()
            if not user_input:
                user_input = input(f"Paste your {provider_name} API key (or Enter to skip): ").strip()
            
            if user_input:
                os.makedirs(os.path.dirname(cred_file), exist_ok=True)
                os.chmod(os.path.dirname(cred_file), 0o700)
                existing = {}
                if os.path.exists(cred_file):
                    try:
                        with open(cred_file, "r", encoding="utf-8") as f:
                            for line in f:
                                line = line.strip()
                                if line and not line.startswith("#") and "=" in line:
                                    k, v = line.split("=", 1)
                                    existing[k.strip()] = v.strip()
                    except Exception:
                        pass
                existing[env_var] = user_input
                with open(cred_file, "w", encoding="utf-8") as f:
                    for k, v in existing.items():
                        f.write(f"{k}={v}\n")
                os.chmod(cred_file, 0o600)
                os.environ[env_var] = user_input
                print(f"✅ Saved {env_var} to ~/.config/agent-loop/credentials.env (locked mode 600)!\n", file=sys.stderr)
                return user_input
        except (KeyboardInterrupt, EOFError):
            print("\nSkipped key input.", file=sys.stderr)
            return ""

    return ""


def extract_verdict_json(raw_text):
    """Robustly extracts structured verdict dictionary from raw text or JSON."""
    if isinstance(raw_text, dict):
        return raw_text

    # Try direct JSON parse
    try:
        parsed = json.loads(raw_text)
        if isinstance(parsed, dict) and "verdict" in parsed:
            return parsed
        if isinstance(parsed, dict) and "structured_output" in parsed:
            return parsed["structured_output"]
        if isinstance(parsed, dict) and "response" in parsed:
            sub = parsed["response"]
            if isinstance(sub, dict) and "verdict" in sub:
                return sub
            if isinstance(sub, str):
                return extract_verdict_json(sub)
    except Exception:
        pass

    # Extract JSON bracket substring
    dec = json.JSONDecoder()
    for i, ch in enumerate(raw_text):
        if ch == "{":
            try:
                obj, _ = dec.raw_decode(raw_text[i:])
                if isinstance(obj, dict) and ("verdict" in obj or "fix_list" in obj):
                    if "verdict" in obj and obj["verdict"] in ("APPROVED", "CHANGES_REQUIRED"):
                        return obj
            except Exception:
                continue

    # Fallback: look for regex verdict in text
    v_match = re.search(r"\b(APPROVED|CHANGES_REQUIRED)\b", raw_text)
    if v_match:
        verdict = v_match.group(1)
        notes = raw_text[:1000]
        fix_list = []
        if verdict == "CHANGES_REQUIRED":
            fixes = re.findall(r"^\s*\d+[\.\)]\s*(.+)$", raw_text, re.MULTILINE)
            fix_list = fixes if fixes else ["See notes for required modifications."]
        return {
            "verdict": verdict,
            "escalate": False,
            "escalate_reason": "",
            "fix_list": fix_list,
            "notes": notes
        }

    return None


def run_claude(system_prompt, user_prompt, schema_text, timeout_sec=600):
    """Invoke Claude Code CLI."""
    if not shutil.which("claude"):
        return None, "claude binary not found in PATH"

    combined_prompt = f"{system_prompt}\n\n---\n\n{user_prompt}"
    cmd = [
        "claude", "-p", combined_prompt,
        "--agent", "step-reviewer",
        "--output-format", "json",
        "--allowedTools", "Bash,Read,Grep,Glob",
        "--disallowedTools", "Bash(git push:*),Bash(git commit:*),Bash(git reset:*)"
    ]
    if schema_text:
        cmd.extend(["--json-schema", schema_text])

    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout_sec)
        out = p.stdout.strip()
        err = p.stderr.strip()
        if p.returncode != 0:
            if "quota" in err.lower() or "429" in err or "limit" in err.lower():
                set_cooldown("claude", 3600 * 4, "quota_exhausted_claude_cli")
            return None, f"claude exited {p.returncode}: {err[:200]}"
        return out, ""
    except subprocess.TimeoutExpired:
        return None, f"claude timed out after {timeout_sec}s"
    except Exception as e:
        return None, f"claude execution error: {e}"


def run_openai_compat(base_url, api_key, model_name, system_prompt, user_prompt, timeout_sec=180, headers_extra=None, provider_id=None):
    """Invoke OpenAI-compatible chat completions endpoint (OpenRouter, DeepSeek, Cloudflare)."""
    if not api_key:
        return None, "API key not found in environment or loop.conf"

    url = f"{base_url.rstrip('/')}/chat/completions"
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {api_key}"
    }
    if headers_extra:
        headers.update(headers_extra)

    payload = {
        "model": model_name,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        "temperature": 0.1,
        "response_format": {"type": "json_object"}
    }

    try:
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers=headers
        )
        with urllib.request.urlopen(req, timeout=timeout_sec) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            choices = data.get("choices", [])
            if choices and "message" in choices[0]:
                return choices[0]["message"].get("content", ""), ""
            return None, "no choices returned in response"
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", errors="replace")
        pid = provider_id or f"api:{model_name}"
        if e.code == 429 or "rate" in err_body.lower() or "quota" in err_body.lower():
            set_cooldown(pid, 1800, f"http_429_{e.code}")
        return None, f"HTTP {e.code}: {err_body[:300]}"
    except Exception as e:
        return None, f"request error: {e}"


def run_agy(model_name, system_prompt, user_prompt, schema_text, timeout_sec=900):
    """Invoke Antigravity headless CLI."""
    agy_bin = shutil.which("agy-resume") or shutil.which("agy")
    if not agy_bin:
        return None, "neither agy-resume nor agy found in PATH"

    combined_prompt = f"{system_prompt}\n\n---\n\n{user_prompt}"
    # "model@effort" (e.g. claude-opus-5-5@high): agy 1.4.8 takes the reasoning effort as its own flag.
    model_name, _, effort = model_name.partition("@")
    cmd = [
        agy_bin, "-p", combined_prompt,
        "--model", model_name,
        "--mode", "plan",
        "--output-format", "json",
        "--print-timeout", f"{int(timeout_sec/60)}m"
    ]
    if effort:
        cmd.extend(["--effort", effort])
    if schema_text:
        cmd.extend(["--json-schema", schema_text])

    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout_sec)
        out = p.stdout.strip()
        err = p.stderr.strip()

        quota_match = re.search(r"quota reached.*?Resets in (?:(\d+)h)?(?:(\d+)m)?", out + "\n" + err, re.IGNORECASE)
        if quota_match:
            hours = int(quota_match.group(1) or 0)
            mins = int(quota_match.group(2) or 0)
            secs = hours * 3600 + mins * 60
            set_cooldown(f"agy:{model_name}", max(300, secs), "agy_quota_reached")
            return None, f"agy model {model_name} quota reached, resets in {hours}h {mins}m"

        if p.returncode != 0:
            if "quota" in (out + err).lower() or "rate" in (out + err).lower():
                set_cooldown(f"agy:{model_name}", 1800, "agy_rate_limit")
            return None, f"agy exited {p.returncode}: {err[:200]}"

        return out, ""
    except subprocess.TimeoutExpired:
        return None, f"agy {model_name} timed out after {timeout_sec}s"
    except Exception as e:
        return None, f"agy execution error: {e}"


def run_ollama(model_name, system_prompt, user_prompt, host=None, timeout_sec=180):
    """Invoke Local Ollama API (Zero quota, 100% offline)."""
    host = host or os.environ.get("OLLAMA_HOST", "http://localhost:11434")
    url = f"{host.rstrip('/')}/api/chat"
    payload = {
        "model": model_name,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        "stream": False,
        "format": "json",
        "options": {
            "temperature": 0.1
        }
    }

    try:
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"}
        )
        with urllib.request.urlopen(req, timeout=timeout_sec) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            msg = data.get("message", {})
            return msg.get("content", ""), ""
    except Exception as e:
        return None, f"ollama ({model_name}) error: {e}"


def execute_provider(provider, system_prompt, user_prompt, schema_text):
    """Executes a single provider and returns (parsed_verdict_dict, raw_output, error_msg)."""
    raw_output = None
    err_msg = ""

    if provider == "claude":
        raw_output, err_msg = run_claude(system_prompt, user_prompt, schema_text)

    elif provider.startswith("openrouter:"):
        model_name = provider.split(":", 1)[1]
        key = ensure_key("openrouter")
        headers_extra = {
            "HTTP-Referer": "https://github.com/agent-loop-kit/agent-loop-kit",
            "X-Title": "Agent Loop Kit High-IQ Supervisor"
        }
        raw_output, err_msg = run_openai_compat(
            base_url="https://openrouter.ai/api/v1",
            api_key=key,
            model_name=model_name,
            system_prompt=system_prompt,
            user_prompt=user_prompt,
            headers_extra=headers_extra,
            provider_id=provider
        )

    elif provider.startswith("deepseek:"):
        model_name = provider.split(":", 1)[1]
        key = ensure_key("deepseek")
        raw_output, err_msg = run_openai_compat(
            base_url="https://api.deepseek.com/v1",
            api_key=key,
            model_name=model_name,
            system_prompt=system_prompt,
            user_prompt=user_prompt,
            provider_id=provider
        )

    elif provider.startswith("cloudflare:"):
        model_name = provider.split(":", 1)[1]
        account_id = os.environ.get("CLOUDFLARE_ACCOUNT_ID", "")
        api_token = os.environ.get("CLOUDFLARE_API_TOKEN", "")
        if not account_id or not api_token:
            err_msg = "CLOUDFLARE_ACCOUNT_ID or CLOUDFLARE_API_TOKEN missing"
        else:
            raw_output, err_msg = run_openai_compat(
                base_url=f"https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1",
                api_key=api_token,
                model_name=model_name,
                system_prompt=system_prompt,
                user_prompt=user_prompt,
                provider_id=provider
            )

    elif provider.startswith("agy:"):
        model_name = provider.split(":", 1)[1]
        raw_output, err_msg = run_agy(model_name, system_prompt, user_prompt, schema_text)

    elif provider.startswith("ollama:"):
        model_name = provider.split(":", 1)[1]
        raw_output, err_msg = run_ollama(model_name, system_prompt, user_prompt)

    else:
        err_msg = f"unknown provider format: {provider}"

    if not raw_output:
        return None, None, err_msg

    parsed = extract_verdict_json(raw_output)
    if parsed and parsed.get("verdict") in ("APPROVED", "CHANGES_REQUIRED"):
        return parsed, raw_output, ""

    return None, raw_output, "invalid verdict structure"


def run_review(rubric_path, prompt_text, schema_path, out_json_path, second_opinion=False, cascade=None):
    load_repo_config()
    explicit_cascade = cascade is not None or bool(os.environ.get("SUPERVISOR_CASCADE"))
    cascade = cascade or os.environ.get("SUPERVISOR_CASCADE", "").split() or DEFAULT_CASCADE
    second_opinion = second_opinion or (os.environ.get("SUPERVISOR_SECOND_OPINION", "").lower() in ("1", "true", "yes"))

    # Reorder cascade based on preferred model in user config
    # IMPORTANT: If an explicit cascade was specified (e.g. for repo privacy), do NOT inject
    # external models from user config if they are not part of the explicit cascade!
    cfg = load_user_config()
    pref = cfg.get("preferred_model")
    if pref:
        if pref in cascade:
            cascade = [pref] + [p for p in cascade if p != pref]
        elif not explicit_cascade:
            cascade = [pref] + cascade

    # 1. Read rubric & schema for prefix-caching static prompt
    rubric_text = ""
    if os.path.exists(rubric_path):
        with open(rubric_path, "r", encoding="utf-8") as f:
            rubric_text = f.read()

    schema_text = ""
    if os.path.exists(schema_path):
        with open(schema_path, "r", encoding="utf-8") as f:
            schema_text = f.read()
    elif schema_path.strip().startswith("{"):
        schema_text = schema_path.strip()

    system_prompt = f"""You are the High-IQ Autonomous Supervisor and Security Auditor.
Your responsibility is rigorous, adversarial verification of code generated by a builder agent.

{rubric_text}

OUTPUT FORMAT CONSTRAINTS:
You MUST respond ONLY with a valid JSON object matching this schema:
{schema_text or '{"verdict": "APPROVED" | "CHANGES_REQUIRED", "escalate": false, "escalate_reason": "", "fix_list": [], "notes": ""}'}

Do not include any prose before or after the JSON.
"""

    user_prompt = f"""Review the following commit evidence against the task specification.

{prompt_text}

Analyze the git diff, test preservation, and gate evidence. Then produce your JSON decision."""

    # Working tree tamper guard
    git_before = ""
    try:
        git_before = subprocess.check_output(
            ["git", "status", "--porcelain", "--untracked-files=no"],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()
    except Exception:
        pass

    # 2. First-Pass Review
    verdict_data = None
    successful_provider = None
    remaining_cascade = []

    for idx, provider in enumerate(cascade):
        provider = provider.strip()
        if not provider:
            continue

        on_cooldown, cd_reason = is_on_cooldown(provider)
        if on_cooldown:
            print(f"supervisor-router: skipping {provider} ({cd_reason})", file=sys.stderr)
            continue

        print_telemetry_hud(provider, system_prompt + "\n" + user_prompt)
        print(f"supervisor-router: attempting review with {provider}...", file=sys.stderr)

        parsed, raw_output, err_msg = execute_provider(provider, system_prompt, user_prompt, schema_text)
        if parsed:
            verdict_data = parsed
            successful_provider = provider
            remaining_cascade = [p.strip() for p in cascade[idx + 1:] if p.strip()]
            break
        else:
            print(f"supervisor-router: {provider} failed: {err_msg}", file=sys.stderr)

    if not verdict_data:
        print("supervisor-router: ALL providers in cascade exhausted or unavailable!", file=sys.stderr)
        with open(out_json_path, "w", encoding="utf-8") as f:
            json.dump({
                "structured_output": {
                    "verdict": "ESCALATED",
                    "escalate": True,
                    "escalate_reason": "All automated review models in cascade exhausted or unavailable.",
                    "fix_list": [],
                    "notes": "Cascade exhaustion. Human inspection required."
                },
                "result": "CASCADE_EXHAUSTED"
            }, f, indent=2)
        sys.exit(1)

    # 3. Second Opinion Protocol
    is_sec = "[security]" in prompt_text.lower()
    needs_second = (second_opinion or is_sec) and (verdict_data["verdict"] == "CHANGES_REQUIRED" or is_sec)

    if needs_second and remaining_cascade:
        print(f"supervisor-router: seeking second opinion (trigger: verdict={verdict_data['verdict']}, security={is_sec})...", file=sys.stderr)
        for sec_cand in remaining_cascade:
            cand_family = sec_cand.split(":")[0]
            prim_family = successful_provider.split(":")[0]
            if cand_family == prim_family and len(remaining_cascade) > 1:
                continue

            on_cd, _ = is_on_cooldown(sec_cand)
            if on_cd:
                continue

            print(f"supervisor-router: second opinion candidate -> {sec_cand}...", file=sys.stderr)
            v2, _, err2 = execute_provider(sec_cand, system_prompt, user_prompt, schema_text)
            if v2:
                v1_dec = verdict_data["verdict"]
                v2_dec = v2["verdict"]
                if v1_dec == v2_dec:
                    print(f"supervisor-router: second opinion CONSENSUS achieved: {v1_dec}", file=sys.stderr)
                    if v1_dec == "CHANGES_REQUIRED":
                        verdict_data["fix_list"] = list(dict.fromkeys(verdict_data.get("fix_list", []) + v2.get("fix_list", [])))
                    verdict_data["notes"] = f"{verdict_data.get('notes', '')} | [2nd Opinion {sec_cand}]: {v2.get('notes', '')}"
                    successful_provider = f"{successful_provider} + {sec_cand}"
                else:
                    print(f"supervisor-router: second opinion SPLIT ({successful_provider}={v1_dec} vs {sec_cand}={v2_dec}) -> ESCALATING", file=sys.stderr)
                    verdict_data["verdict"] = "CHANGES_REQUIRED"
                    verdict_data["escalate"] = True
                    verdict_data["escalate_reason"] = f"Reviewer split-decision: {successful_provider} voted {v1_dec}, but {sec_cand} voted {v2_dec}."
                    verdict_data["fix_list"] = verdict_data.get("fix_list", []) + [f"Conflicting verdict from {sec_cand}: {v2_dec}"]
                    verdict_data["notes"] = f"Split-decision. {successful_provider}: {v1_dec} | {sec_cand}: {v2_dec}."
                    successful_provider = f"{successful_provider} vs {sec_cand}"
                break
        else:
            print(f"supervisor-router: {provider} returned invalid verdict structure", file=sys.stderr)

    # 3. Read-only sanity check: Reviewer process must never mutate code
    try:
        git_after = subprocess.check_output(
            ["git", "status", "--porcelain", "--untracked-files=no"],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()
        if git_before != git_after:
            print("supervisor-router: ERROR - review process modified working tree! Voiding verdict.", file=sys.stderr)
            sys.exit(3)
    except Exception:
        pass

    # 4. Write final out.json
    if not verdict_data:
        print("supervisor-router: ALL providers in cascade exhausted!", file=sys.stderr)
        with open(out_json_path, "w", encoding="utf-8") as f:
            json.dump({
                "structured_output": {
                    "verdict": "ESCALATED",
                    "escalate": True,
                    "escalate_reason": "All automated review models in cascade exhausted or unavailable.",
                    "fix_list": [],
                    "notes": "Cascade exhaustion. Human inspection required."
                },
                "result": "CASCADE_EXHAUSTED"
            }, f, indent=2)
        sys.exit(1)

    # Normalize fields
    v = verdict_data.get("verdict", "CHANGES_REQUIRED")
    fix_list = verdict_data.get("fix_list", [])
    if v == "CHANGES_REQUIRED" and not fix_list:
        fix_list = [f"Fix requested by {successful_provider}. See notes: {verdict_data.get('notes', '')[:500]}"]

    structured = {
        "verdict": v,
        "escalate": bool(verdict_data.get("escalate", False)),
        "escalate_reason": verdict_data.get("escalate_reason", ""),
        "fix_list": fix_list,
        "notes": f"[reviewed by: {successful_provider}] " + verdict_data.get("notes", ""),
        "reviewer": f"supervisor-router ({successful_provider})"
    }

    with open(out_json_path, "w", encoding="utf-8") as f:
        json.dump({
            "structured_output": structured,
            "result": json.dumps(structured)
        }, f, indent=2)

    print(f"supervisor-router: review complete! Verdict: {v} via {successful_provider}", file=sys.stderr)
    sys.exit(0)


def show_status():
    ensure_cache()
    load_repo_config()
    cooldowns = load_cooldowns()
    now = int(time.time())
    cred_file = os.path.expanduser("~/.config/agent-loop/credentials.env")
    print("==================================================")
    print("Supervisor Router: Multi-Brain Provider Status")
    print(f"Credentials File: {cred_file}")
    print("==================================================")
    for p in DEFAULT_CASCADE:
        entry = cooldowns.get(p)
        if entry and now < entry.get("cooldown_until", 0):
            rem = int((entry["cooldown_until"] - now) / 60)
            print(f"  [COOLDOWN] {p:38} Cooldown active ({rem}m remaining; {entry.get('reason','')})")
        elif p.startswith("openrouter:") or p.startswith("deepseek:") or p.startswith("cloudflare:"):
            prov = p.split(":")[0]
            env_var = f"{prov.upper()}_API_KEY"
            key_val = os.environ.get(env_var, "")
            if key_val:
                masked = f"Key: sk-****...{key_val[-4:]}" if len(key_val) > 8 else "Key: OK"
                print(f"  [READY]    {p:38} {masked}")
            else:
                print(f"  [NEED KEY] {p:38} Missing {env_var} (will prompt on the fly)")
        else:
            print(f"  [READY]    {p:38} Ready for review")
    print("==================================================")


def set_key_interactive(provider="openrouter"):
    """Safely prompt the user for an API key and store it in ~/.config/agent-loop/credentials.env with chmod 600."""
    ensure_cache()
    cred_file = os.path.expanduser("~/.config/agent-loop/credentials.env")
    os.makedirs(os.path.dirname(cred_file), exist_ok=True)
    os.chmod(os.path.dirname(cred_file), 0o700)

    import getpass
    print("==================================================")
    print(f"  Secure Credential Setup: {provider.upper()}")
    print("==================================================")
    try:
        val = getpass.getpass(f"Paste your {provider} API key (input will be hidden): ").strip()
    except (KeyboardInterrupt, EOFError):
        print("\nAborted.")
        sys.exit(1)

    if not val:
        print("No key entered. Aborting.")
        sys.exit(1)

    env_var = f"{provider.upper()}_API_KEY"
    existing = {}
    if os.path.exists(cred_file):
        try:
            with open(cred_file, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, v = line.split("=", 1)
                        existing[k.strip()] = v.strip()
        except Exception:
            pass

    existing[env_var] = val
    with open(cred_file, "w", encoding="utf-8") as f:
        for k, v in existing.items():
            f.write(f"{k}={v}\n")
    os.chmod(cred_file, 0o600)
    print(f"\n✅ Successfully saved {env_var} to ~/.config/agent-loop/credentials.env (locked mode 600)!")
    print("==================================================")


def main():
    if len(sys.argv) >= 2 and sys.argv[1] in ("--switch", "switch"):
        target = sys.argv[2] if len(sys.argv) > 2 else None
        switch_model_interactive(target)
        sys.exit(0)
    elif len(sys.argv) >= 2 and sys.argv[1] in ("--info", "info"):
        cfg = load_user_config()
        pref = cfg.get("preferred_model", DEFAULT_CASCADE[0])
        print_telemetry_hud(pref)
        sys.exit(0)
    elif len(sys.argv) >= 2 and sys.argv[1] in ("--set-key", "set-key"):
        provider = sys.argv[2] if len(sys.argv) > 2 else "openrouter"
        set_key_interactive(provider)
        sys.exit(0)
    elif len(sys.argv) == 2 and sys.argv[1] in ("--status", "status"):
        show_status()
        sys.exit(0)
    elif len(sys.argv) == 2 and sys.argv[1] in ("--clear-cache", "clear-cache"):
        if os.path.exists(COOLDOWN_FILE):
            os.remove(COOLDOWN_FILE)
        print("supervisor-router: cooldown cache cleared.")
        sys.exit(0)

    pos = [a for a in sys.argv[1:] if not a.startswith("--")]
    second_opinion = ("--second-opinion" in sys.argv) or (os.environ.get("SUPERVISOR_SECOND_OPINION", "").lower() in ("1", "true", "yes"))

    if len(pos) < 4:
        print("Usage: supervisor-router <rubric.md> <prompt-text> <schema-json-or-file> <out.json> [--second-opinion]", file=sys.stderr)
        print("       supervisor-router --status          # View all provider statuses", file=sys.stderr)
        print("       supervisor-router --switch          # Switch active primary model", file=sys.stderr)
        print("       supervisor-router --info            # View current model telemetry HUD", file=sys.stderr)
        print("       supervisor-router --set-key         # Securely set API key", file=sys.stderr)
        sys.exit(2)

    rubric, prompt, schema, out_file = pos[:4]
    run_review(rubric, prompt, schema, out_file, second_opinion=second_opinion)


if __name__ == "__main__":
    main()
