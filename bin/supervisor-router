#!/usr/bin/env python3
"""
supervisor-router — High-IQ Multi-Brain Agent Supervisor with Zero-Downtime Failover.

Implements the October 2026 Zero-Bottleneck AI Code Review architecture:
1. Separation of Powers: Independent model family between Builder and Reviewer.
2. Multi-Brain Cascade:
   - Claude Code CLI (Sonnet / Opus)
   - OpenRouter Frontier (Qwen3-Coder 480B [256K-1M ctx], DeepSeek V4.1 Flash, GPT-OSS 120B)
   - DeepSeek Direct API (DeepSeek V4.1 Flash, DeepSeek V4 Pro)
   - Cloudflare Workers AI (GLM-4.7-Flash)
   - Antigravity Headless (Gemini 3.8 Flash High, Claude Sonnet, GPT-OSS 120B)
   - Local Ollama (DeepSeek-R1, Qwen2.5-7B, Llama3.2) — 100% offline, zero-quota
3. Prefix-Caching Optimization:
   - Invariant system persona, rubric & JSON schema placed first in KV cache.
   - Dynamic git diff & gate evidence placed at tail for maximum cache reuse (90-98% savings).
4. Zero Data Retention (ZDR) headers and hard read-only execution.

Usage:
    supervisor-router <rubric.md> <prompt-text> <schema-json-or-file> <out.json>
    supervisor-router --status
    supervisor-router --clear-cache
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone

CACHE_DIR = os.path.expanduser("~/.cache/agent-loop")
COOLDOWN_FILE = os.path.join(CACHE_DIR, "quota-status.json")

# Default cascade order spanning independent model families
DEFAULT_CASCADE = [
    "claude",
    "openrouter:qwen/qwen3-coder:free",
    "openrouter:deepseek/deepseek-v4.1-flash",
    "openrouter:openai/gpt-oss-120b:free",
    "deepseek:deepseek-chat",
    "agy:gemini-3.8-flash-high",
    "agy:claude-sonnet-4-6",
    "agy:gpt-oss-120b-medium",
    "ollama:deepseek-r1:latest",
    "ollama:qwen2.5-7b:latest",
    "ollama:llama3.2:3b"
]


def ensure_cache():
    os.makedirs(CACHE_DIR, exist_ok=True)
    if not os.path.exists(COOLDOWN_FILE):
        with open(COOLDOWN_FILE, "w", encoding="utf-8") as f:
            json.dump({}, f)


def load_cooldowns():
    ensure_cache()
    try:
        with open(COOLDOWN_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def set_cooldown(provider_id, seconds_from_now=3600, reason="quota_exhausted"):
    cooldowns = load_cooldowns()
    until = int(time.time()) + max(60, int(seconds_from_now))
    cooldowns[provider_id] = {
        "cooldown_until": until,
        "cooldown_until_iso": datetime.fromtimestamp(until, timezone.utc).isoformat(),
        "reason": reason,
        "recorded_at": datetime.now(timezone.utc).isoformat()
    }
    with open(COOLDOWN_FILE, "w", encoding="utf-8") as f:
        json.dump(cooldowns, f, indent=2)
    print(f"supervisor-router: marked {provider_id} on cooldown for {seconds_from_now}s ({reason})", file=sys.stderr)


def is_on_cooldown(provider_id):
    cooldowns = load_cooldowns()
    entry = cooldowns.get(provider_id)
    if not entry:
        return False, ""
    until = entry.get("cooldown_until", 0)
    now = int(time.time())
    if now < until:
        remaining_min = int((until - now) / 60)
        return True, f"cooldown active ({remaining_min}m remaining; {entry.get('reason', '')})"
    return False, ""


def load_repo_config():
    """Load settings from ~/.config/agent-loop/credentials.env and .supervision/loop.conf."""
    # 1. Load user-global secure credentials (~/.config/agent-loop/credentials.env)
    user_cred = os.path.expanduser("~/.config/agent-loop/credentials.env")
    if os.path.exists(user_cred):
        try:
            with open(user_cred, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, v = line.split("=", 1)
                        k = k.strip()
                        v = v.strip().strip('"').strip("'")
                        if k and not os.environ.get(k):
                            os.environ[k] = v
        except Exception:
            pass

    # 2. Load repo-local settings (.supervision/loop.conf)
    try:
        root = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()
        conf_path = os.path.join(root, ".supervision", "loop.conf")
        if os.path.exists(conf_path):
            with open(conf_path, "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        k, v = line.split("=", 1)
                        k = k.strip()
                        v = v.strip().strip('"').strip("'")
                        if k and not os.environ.get(k):
                            os.environ[k] = v
    except Exception:
        pass


def extract_verdict_json(raw_text):
    """Robustly extracts structured verdict dictionary from raw text or JSON."""
    if isinstance(raw_text, dict):
        return raw_text

    # Try direct JSON parse
    try:
        parsed = json.loads(raw_text)
        if isinstance(parsed, dict) and "verdict" in parsed:
            return parsed
        if isinstance(parsed, dict) and "structured_output" in parsed:
            return parsed["structured_output"]
        if isinstance(parsed, dict) and "response" in parsed:
            sub = parsed["response"]
            if isinstance(sub, dict) and "verdict" in sub:
                return sub
            if isinstance(sub, str):
                return extract_verdict_json(sub)
    except Exception:
        pass

    # Extract JSON bracket substring
    dec = json.JSONDecoder()
    for i, ch in enumerate(raw_text):
        if ch == "{":
            try:
                obj, _ = dec.raw_decode(raw_text[i:])
                if isinstance(obj, dict) and ("verdict" in obj or "fix_list" in obj):
                    if "verdict" in obj and obj["verdict"] in ("APPROVED", "CHANGES_REQUIRED"):
                        return obj
            except Exception:
                continue

    # Fallback: look for regex verdict in text
    v_match = re.search(r"\b(APPROVED|CHANGES_REQUIRED)\b", raw_text)
    if v_match:
        verdict = v_match.group(1)
        notes = raw_text[:1000]
        fix_list = []
        if verdict == "CHANGES_REQUIRED":
            fixes = re.findall(r"^\s*\d+[\.\)]\s*(.+)$", raw_text, re.MULTILINE)
            fix_list = fixes if fixes else ["See notes for required modifications."]
        return {
            "verdict": verdict,
            "escalate": False,
            "escalate_reason": "",
            "fix_list": fix_list,
            "notes": notes
        }

    return None


def run_claude(system_prompt, user_prompt, schema_text, timeout_sec=600):
    """Invoke Claude Code CLI."""
    if not shutil.which("claude"):
        return None, "claude binary not found in PATH"

    combined_prompt = f"{system_prompt}\n\n---\n\n{user_prompt}"
    cmd = [
        "claude", "-p", combined_prompt,
        "--agent", "step-reviewer",
        "--output-format", "json",
        "--allowedTools", "Bash,Read,Grep,Glob",
        "--disallowedTools", "Bash(git push:*),Bash(git commit:*),Bash(git reset:*)"
    ]
    if schema_text:
        cmd.extend(["--json-schema", schema_text])

    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout_sec)
        out = p.stdout.strip()
        err = p.stderr.strip()
        if p.returncode != 0:
            if "quota" in err.lower() or "429" in err or "limit" in err.lower():
                set_cooldown("claude", 3600 * 4, "quota_exhausted_claude_cli")
            return None, f"claude exited {p.returncode}: {err[:200]}"
        return out, ""
    except subprocess.TimeoutExpired:
        return None, f"claude timed out after {timeout_sec}s"
    except Exception as e:
        return None, f"claude execution error: {e}"


def run_openai_compat(base_url, api_key, model_name, system_prompt, user_prompt, timeout_sec=180, headers_extra=None, provider_id=None):
    """Invoke OpenAI-compatible chat completions endpoint (OpenRouter, DeepSeek, Cloudflare)."""
    if not api_key:
        return None, "API key not found in environment or loop.conf"

    url = f"{base_url.rstrip('/')}/chat/completions"
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {api_key}"
    }
    if headers_extra:
        headers.update(headers_extra)

    payload = {
        "model": model_name,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        "temperature": 0.1,
        "response_format": {"type": "json_object"}
    }

    try:
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers=headers
        )
        with urllib.request.urlopen(req, timeout=timeout_sec) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            choices = data.get("choices", [])
            if choices and "message" in choices[0]:
                return choices[0]["message"].get("content", ""), ""
            return None, "no choices returned in response"
    except urllib.error.HTTPError as e:
        err_body = e.read().decode("utf-8", errors="replace")
        pid = provider_id or f"api:{model_name}"
        if e.code == 429 or "rate" in err_body.lower() or "quota" in err_body.lower():
            set_cooldown(pid, 1800, f"http_429_{e.code}")
        return None, f"HTTP {e.code}: {err_body[:300]}"
    except Exception as e:
        return None, f"request error: {e}"


def run_agy(model_name, system_prompt, user_prompt, schema_text, timeout_sec=900):
    """Invoke Antigravity headless CLI."""
    agy_bin = shutil.which("agy-resume") or shutil.which("agy")
    if not agy_bin:
        return None, "neither agy-resume nor agy found in PATH"

    combined_prompt = f"{system_prompt}\n\n---\n\n{user_prompt}"
    cmd = [
        agy_bin, "-p", combined_prompt,
        "--model", model_name,
        "--mode", "plan",
        "--output-format", "json",
        "--print-timeout", f"{int(timeout_sec/60)}m"
    ]
    if schema_text:
        cmd.extend(["--json-schema", schema_text])

    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout_sec)
        out = p.stdout.strip()
        err = p.stderr.strip()

        quota_match = re.search(r"quota reached.*?Resets in (?:(\d+)h)?(?:(\d+)m)?", out + "\n" + err, re.IGNORECASE)
        if quota_match:
            hours = int(quota_match.group(1) or 0)
            mins = int(quota_match.group(2) or 0)
            secs = hours * 3600 + mins * 60
            set_cooldown(f"agy:{model_name}", max(300, secs), "agy_quota_reached")
            return None, f"agy model {model_name} quota reached, resets in {hours}h {mins}m"

        if p.returncode != 0:
            if "quota" in (out + err).lower() or "rate" in (out + err).lower():
                set_cooldown(f"agy:{model_name}", 1800, "agy_rate_limit")
            return None, f"agy exited {p.returncode}: {err[:200]}"

        return out, ""
    except subprocess.TimeoutExpired:
        return None, f"agy {model_name} timed out after {timeout_sec}s"
    except Exception as e:
        return None, f"agy execution error: {e}"


def run_ollama(model_name, system_prompt, user_prompt, host=None, timeout_sec=180):
    """Invoke Local Ollama API (Zero quota, 100% offline)."""
    host = host or os.environ.get("OLLAMA_HOST", "http://localhost:11434")
    url = f"{host.rstrip('/')}/api/chat"
    payload = {
        "model": model_name,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        "stream": False,
        "format": "json",
        "options": {
            "temperature": 0.1
        }
    }

    try:
        req = urllib.request.Request(
            url,
            data=json.dumps(payload).encode("utf-8"),
            headers={"Content-Type": "application/json"}
        )
        with urllib.request.urlopen(req, timeout=timeout_sec) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            msg = data.get("message", {})
            return msg.get("content", ""), ""
    except Exception as e:
        return None, f"ollama ({model_name}) error: {e}"


def run_review(rubric_path, prompt_text, schema_path, out_json_path, cascade=None):
    load_repo_config()
    cascade = cascade or os.environ.get("SUPERVISOR_CASCADE", "").split() or DEFAULT_CASCADE

    # 1. Read rubric & schema for prefix-caching static prompt
    rubric_text = ""
    if os.path.exists(rubric_path):
        with open(rubric_path, "r", encoding="utf-8") as f:
            rubric_text = f.read()

    schema_text = ""
    if os.path.exists(schema_path):
        with open(schema_path, "r", encoding="utf-8") as f:
            schema_text = f.read()
    elif schema_path.strip().startswith("{"):
        schema_text = schema_path.strip()

    # Deterministic KV-cache prefix structure:
    # System message: Role + Invariant Rubric + JSON schema instructions (static)
    # User message: Target Task Spec + Gate Evidence + Diff (dynamic tail)
    system_prompt = f"""You are the High-IQ Autonomous Supervisor and Security Auditor.
Your responsibility is rigorous, adversarial verification of code generated by a builder agent.

{rubric_text}

OUTPUT FORMAT CONSTRAINTS:
You MUST respond ONLY with a valid JSON object matching this schema:
{schema_text or '{"verdict": "APPROVED" | "CHANGES_REQUIRED", "escalate": false, "escalate_reason": "", "fix_list": [], "notes": ""}'}

Do not include any prose before or after the JSON.
"""

    user_prompt = f"""Review the following commit evidence against the task specification.

{prompt_text}

Analyze the git diff, test preservation, and gate evidence. Then produce your JSON decision."""

    # Working tree tamper guard
    git_before = ""
    try:
        git_before = subprocess.check_output(
            ["git", "status", "--porcelain", "--untracked-files=no"],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()
    except Exception:
        pass

    # 2. Iterate through multi-brain cascade
    verdict_data = None
    successful_provider = None

    for provider in cascade:
        provider = provider.strip()
        if not provider:
            continue

        on_cooldown, cd_reason = is_on_cooldown(provider)
        if on_cooldown:
            print(f"supervisor-router: skipping {provider} ({cd_reason})", file=sys.stderr)
            continue

        print(f"supervisor-router: attempting review with {provider}...", file=sys.stderr)
        raw_output = None
        err_msg = ""

        if provider == "claude":
            raw_output, err_msg = run_claude(system_prompt, user_prompt, schema_text)

        elif provider.startswith("openrouter:"):
            model_name = provider.split(":", 1)[1]
            key = os.environ.get("OPENROUTER_API_KEY", "")
            headers_extra = {
                "HTTP-Referer": "https://github.com/agent-loop-kit/agent-loop-kit",
                "X-Title": "Agent Loop Kit High-IQ Supervisor"
            }
            raw_output, err_msg = run_openai_compat(
                base_url="https://openrouter.ai/api/v1",
                api_key=key,
                model_name=model_name,
                system_prompt=system_prompt,
                user_prompt=user_prompt,
                headers_extra=headers_extra,
                provider_id=provider
            )

        elif provider.startswith("deepseek:"):
            model_name = provider.split(":", 1)[1]
            key = os.environ.get("DEEPSEEK_API_KEY", "")
            raw_output, err_msg = run_openai_compat(
                base_url="https://api.deepseek.com/v1",
                api_key=key,
                model_name=model_name,
                system_prompt=system_prompt,
                user_prompt=user_prompt,
                provider_id=provider
            )

        elif provider.startswith("cloudflare:"):
            model_name = provider.split(":", 1)[1]
            account_id = os.environ.get("CLOUDFLARE_ACCOUNT_ID", "")
            api_token = os.environ.get("CLOUDFLARE_API_TOKEN", "")
            if not account_id or not api_token:
                err_msg = "CLOUDFLARE_ACCOUNT_ID or CLOUDFLARE_API_TOKEN missing"
            else:
                raw_output, err_msg = run_openai_compat(
                    base_url=f"https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1",
                    api_key=api_token,
                    model_name=model_name,
                    system_prompt=system_prompt,
                    user_prompt=user_prompt,
                    provider_id=provider
                )

        elif provider.startswith("agy:"):
            model_name = provider.split(":", 1)[1]
            raw_output, err_msg = run_agy(model_name, system_prompt, user_prompt, schema_text)

        elif provider.startswith("ollama:"):
            model_name = provider.split(":", 1)[1]
            raw_output, err_msg = run_ollama(model_name, system_prompt, user_prompt)

        else:
            err_msg = f"unknown provider format: {provider}"

        if not raw_output:
            print(f"supervisor-router: {provider} failed: {err_msg}", file=sys.stderr)
            continue

        # Extract structured verdict
        parsed = extract_verdict_json(raw_output)
        if parsed and parsed.get("verdict") in ("APPROVED", "CHANGES_REQUIRED"):
            verdict_data = parsed
            successful_provider = provider
            break
        else:
            print(f"supervisor-router: {provider} returned invalid verdict structure", file=sys.stderr)

    # 3. Read-only sanity check: Reviewer process must never mutate code
    try:
        git_after = subprocess.check_output(
            ["git", "status", "--porcelain", "--untracked-files=no"],
            stderr=subprocess.DEVNULL,
            text=True
        ).strip()
        if git_before != git_after:
            print("supervisor-router: ERROR - review process modified working tree! Voiding verdict.", file=sys.stderr)
            sys.exit(3)
    except Exception:
        pass

    # 4. Write final out.json
    if not verdict_data:
        print("supervisor-router: ALL providers in cascade exhausted!", file=sys.stderr)
        with open(out_json_path, "w", encoding="utf-8") as f:
            json.dump({
                "structured_output": {
                    "verdict": "ESCALATED",
                    "escalate": True,
                    "escalate_reason": "All automated review models in cascade exhausted or unavailable.",
                    "fix_list": [],
                    "notes": "Cascade exhaustion. Human inspection required."
                },
                "result": "CASCADE_EXHAUSTED"
            }, f, indent=2)
        sys.exit(1)

    # Normalize fields
    v = verdict_data.get("verdict", "CHANGES_REQUIRED")
    fix_list = verdict_data.get("fix_list", [])
    if v == "CHANGES_REQUIRED" and not fix_list:
        fix_list = [f"Fix requested by {successful_provider}. See notes: {verdict_data.get('notes', '')[:500]}"]

    structured = {
        "verdict": v,
        "escalate": bool(verdict_data.get("escalate", False)),
        "escalate_reason": verdict_data.get("escalate_reason", ""),
        "fix_list": fix_list,
        "notes": f"[reviewed by: {successful_provider}] " + verdict_data.get("notes", ""),
        "reviewer": f"supervisor-router ({successful_provider})"
    }

    with open(out_json_path, "w", encoding="utf-8") as f:
        json.dump({
            "structured_output": structured,
            "result": json.dumps(structured)
        }, f, indent=2)

    print(f"supervisor-router: review complete! Verdict: {v} via {successful_provider}", file=sys.stderr)
    sys.exit(0)


def show_status():
    ensure_cache()
    cooldowns = load_cooldowns()
    now = int(time.time())
    print("==================================================")
    print("Supervisor Router: Multi-Brain Provider Status")
    print("==================================================")
    for p in DEFAULT_CASCADE:
        entry = cooldowns.get(p)
        if entry and now < entry.get("cooldown_until", 0):
            rem = int((entry["cooldown_until"] - now) / 60)
            print(f"  [COOLDOWN] {p:38} Cooldown active ({rem}m remaining; {entry.get('reason','')})")
        else:
            print(f"  [READY]    {p:38} Ready for review")
    print("==================================================")


def main():
    if len(sys.argv) == 2 and sys.argv[1] in ("--status", "status"):
        show_status()
        sys.exit(0)
    elif len(sys.argv) == 2 and sys.argv[1] in ("--clear-cache", "clear-cache"):
        if os.path.exists(COOLDOWN_FILE):
            os.remove(COOLDOWN_FILE)
        print("supervisor-router: cooldown cache cleared.")
        sys.exit(0)

    if len(sys.argv) < 5:
        print("Usage: supervisor-router <rubric.md> <prompt-text> <schema-json-or-file> <out.json>", file=sys.stderr)
        print("       supervisor-router --status", file=sys.stderr)
        sys.exit(2)

    rubric = sys.argv[1]
    prompt = sys.argv[2]
    schema = sys.argv[3]
    out_file = sys.argv[4]

    run_review(rubric, prompt, schema, out_file)


if __name__ == "__main__":
    main()
