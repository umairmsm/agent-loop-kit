#!/usr/bin/env bash
# loop-status: one-screen answer to "is the loop running, and what is it doing?"
# Usage: loop-status [repo]   (default: $PWD)
set -uo pipefail

R="${1:-}"
if [ -z "$R" ]; then
  if [ -d "$PWD/.supervision" ]; then
    R="$PWD"
  else
    echo "loop-status: not in a supervised repository (no .supervision/ found). Usage: loop-status [repo-path]" >&2
    exit 1
  fi
fi

cd "$R" || exit 1
L=.supervision/loop.log
echo "== $(basename "$R")   $(date '+%F %H:%M')"

if pgrep -f "bin/agy-supervise" >/dev/null 2>&1; then
  echo "watchdog : RUNNING (agy-supervise)"
else
  echo "watchdog : not running"
fi

lp="$(for p in $(pgrep -f 'bin/agy-loop' 2>/dev/null); do [ "$(readlink /proc/$p/cwd 2>/dev/null)" = "$PWD" ] && echo "$p"; done | head -1)"
if [ -n "$lp" ]; then
  task_name="$(tr '\0' ' ' < /proc/$lp/cmdline 2>/dev/null | grep -oE 'docs/supervision/[^ ]+' || echo "active")"
  echo "loop     : RUNNING ($task_name)"
else
  echo "loop     : STOPPED"
fi

bp="$(for p in $(pgrep -f 'agy -p You are the BUILDER' 2>/dev/null); do [ "$(readlink /proc/$p/cwd 2>/dev/null)" = "$PWD" ] && echo "$p"; done | head -1)"
[ -n "$bp" ] && echo "builder  : working for $(ps -o etime= -p "$bp" 2>/dev/null | tr -d ' ')"

if [ -f .supervision/loop-state.json ]; then
  python3 -c 'import json; d=json.load(open(".supervision/loop-state.json")); print("position :", d.get("task","").split("/")[-1], "step", d.get("step","?"), "attempt", d.get("attempt","?"))' 2>/dev/null || true
fi

echo "reviewer : $(grep -oE '^REVIEWER="[a-z]+"' .supervision/loop.conf 2>/dev/null || echo 'REVIEWER="claude" (default)')"
echo "-- last events"
if [ -f "$L" ]; then
  grep -E "building|commit [0-9a-f]{7}|APPROVED|CHANGES_REQUIRED|ESCALAT|STOP|supervise:|claims audit|steps APPROVED" "$L" 2>/dev/null | tail -6 | cut -c1-170 || echo "no matching events"
else
  echo "no loop.log found"
fi
